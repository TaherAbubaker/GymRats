@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - GymRats</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: 'Poppins', sans-serif;
            }

            .auth-wrapper {
                display: flex;
                min-height: 100vh;
            }

            .auth-visual {
                flex: 1;
                position: relative;
                background: linear-gradient(rgba(10, 20, 30, 0.75), rgba(10, 20, 30, 0.85)), url('/images/gym-hero.jpg') center/cover no-repeat;
                background-color: #0d1b26; /* fallback until a real photo is added */
                color: #fff;
                padding: 48px;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
            }

                .auth-visual .brand {
                    font-family: 'Playfair Display', serif;
                    font-size: 2.25rem;
                    font-weight: 900;
                    color: var(--color-primary, #a61b1b);
                    letter-spacing: 1px;
                }

                .auth-visual .headline {
                    font-family: 'Playfair Display', serif;
                    font-size: 3.5rem;
                    font-weight: 900;
                    line-height: 1.05;
                    margin-bottom: 16px;
                }

                .auth-visual .subtext {
                    max-width: 420px;
                    font-size: 1rem;
                    color: #d7dee5;
                    line-height: 1.6;
                }

            .auth-form-side {
                flex: 1;
                background-color: #f4f7fb;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 48px;
            }

            .auth-form-inner {
                width: 100%;
                max-width: 420px;
            }

                .auth-form-inner h1 {
                    font-family: 'Playfair Display', serif;
                    font-weight: 900;
                    font-size: 2.5rem;
                    line-height: 1.15;
                    color: #14212b;
                    margin-bottom: 32px;
                }

            .auth-label {
                display: block;
                font-size: 0.75rem;
                font-weight: 700;
                letter-spacing: 1px;
                text-transform: uppercase;
                color: #14212b;
                margin-bottom: 8px;
            }

            .auth-input {
                width: 100%;
                padding: 14px 16px;
                margin-bottom: 20px;
                border: 1px solid #b7c4d6;
                border-radius: 4px;
                background-color: #d9e6f7;
                font-family: 'Poppins', sans-serif;
                font-size: 0.95rem;
                color: #14212b;
            }

                .auth-input::placeholder {
                    color: #7c93a8;
                }

            .auth-submit {
                width: 100%;
                padding: 16px;
                background-color: var(--color-primary, #a61b1b);
                color: #fff;
                border: none;
                border-radius: 4px;
                font-weight: 700;
                letter-spacing: 1px;
                text-transform: uppercase;
                font-size: 0.9rem;
                cursor: pointer;
                margin-top: 8px;
            }

                .auth-submit:hover {
                    background-color: #8a1616;
                }

            .auth-divider {
                border: none;
                border-top: 1px solid #d5dde6;
                margin: 24px 0;
            }

            .auth-footer-text {
                text-align: center;
                font-size: 0.9rem;
                color: #4a5a68;
            }

                .auth-footer-text a {
                    color: #14212b;
                    font-weight: 700;
                    text-decoration: underline;
                }

            .auth-error {
                color: #a61b1b;
                font-size: 0.9rem;
                margin-bottom: 16px;
            }
            
    </style>
</head>
<body>
    <div class="auth-wrapper">
        <div class="auth-visual">
            <div class="brand">GYMRAT</div>
            <div>
                <div class="headline">JOIN THE<br />GRIND.</div>
                <p class="subtext">Pain is weakness leaving the body. Sign in to access your bookings, track your classes, and push your limits.</p>
            </div>
        </div>

        <div class="auth-form-side">
            <div class="auth-form-inner">
                <h1>WELCOME BACK,<br />GYMRAT.</h1>

                <div asp-validation-summary="All" class="auth-error"></div>

                <form asp-action="Login" asp-controller="Account" method="post">
                    <label class="auth-label" for="email">Email Address</label>
                    <input type="text" id="email" name="email" class="auth-input" placeholder="athlete@example.com" />

                    <label class="auth-label" for="password">Password</label>
                    <input type="password" id="password" name="password" class="auth-input" placeholder="••••••••" />

                    <button type="submit" class="auth-submit">Login</button>
                </form>

                <hr class="auth-divider" />

                <p class="auth-footer-text">
                    Don't have an account yet? <a asp-controller="Account" asp-action="Register">Register Now</a>
                </p>
            </div>
        </div>
    </div>
</body>
</html>