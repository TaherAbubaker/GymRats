@model GymRats.Models.User
@{
    Layout = null;
    ViewData["Title"] = "Change Password";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Change Password - GymRats</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Poppins', sans-serif;
                background-color: #f8fafc;
                color: #14212b;
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }

            .auth-container {
                max-width: 500px;
                width: 100%;
                margin: 80px auto;
                padding: 0 24px;
                flex: 1;
            }

            .card-light {
                background-color: #dbeafe;
                padding: 40px;
                border-radius: 2px;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            }

            .page-title {
                font-family: 'Playfair Display', serif;
                font-size: 2.5rem;
                font-weight: 900;
                text-transform: uppercase;
                color: #0f172a;
                line-height: 1.1;
                margin-bottom: 8px;
            }

            .title-accent {
                width: 60px;
                height: 5px;
                background-color: #b91c1c;
                margin-bottom: 32px;
            }

            .auth-label {
                display: block;
                font-size: 0.75rem;
                font-weight: 700;
                letter-spacing: 1px;
                text-transform: uppercase;
                color: #0f172a;
                margin-bottom: 8px;
            }

            .auth-input {
                width: 100%;
                padding: 14px 16px;
                margin-bottom: 20px;
                border: 1px solid #cbd5e1;
                border-radius: 2px;
                background-color: #ffffff;
                font-family: 'Poppins', sans-serif;
                font-size: 0.95rem;
                color: #14212b;
            }

                .auth-input:focus {
                    outline: none;
                    border-color: #b91c1c;
                }

            .auth-submit {
                width: 100%;
                padding: 16px;
                background-color: #b91c1c;
                color: #fff;
                border: none;
                border-radius: 2px;
                font-weight: 700;
                letter-spacing: 1px;
                text-transform: uppercase;
                font-size: 0.9rem;
                cursor: pointer;
                transition: background-color 0.2s ease;
                margin-top: 8px;
            }

                .auth-submit:hover {
                    background-color: #991b1b;
                }

            .auth-error {
                color: #b91c1c;
                font-size: 0.85rem;
                font-weight: 600;
                margin-bottom: 20px;
                background-color: #fee2e2;
                padding: 10px 14px;
                border-left: 4px solid #b91c1c;
            }

            .back-link {
                display: block;
                text-align: center;
                margin-top: 24px;
                font-size: 0.8rem;
                font-weight: 700;
                color: #3b82f6;
                text-decoration: none;
                letter-spacing: 1px;
                text-transform: uppercase;
            }

                .back-link:hover {
                    text-decoration: underline;
                }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="card-light">
            <h1 class="page-title">Change Password</h1>
            <div class="title-accent"></div>

			<!-- we have to add more of those later for error handling better UX-->
            <div asp-validation-summary="All" class="auth-error"></div>

            <form asp-action="ChangePassword" asp-controller="Account" method="post">
                <label class="auth-label" for="oldPassword">Old Password</label>
                <input type="password" id="oldPassword" name="oldPassword" class="auth-input" placeholder="********" required />

                <label class="auth-label" for="newPassword">New Password</label>
                <input type="password" id="newPassword" name="newPassword" class="auth-input" placeholder="********" required />

                <button type="submit" class="auth-submit">Update Password</button>
            </form>

            <a asp-controller="Account" asp-action="Profile" class="back-link">← Back to Profile</a>
        </div>
    </div>
</body>
</html>