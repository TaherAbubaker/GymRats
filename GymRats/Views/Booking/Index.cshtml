@model List<GymRats.Models.Booking>

@{
    ViewData["Title"] = "My Bookings";
}

<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --gr-dark: #0f1620;
        --gr-dark-soft: #172231;
        --gr-accent: #FF5722;
        --gr-accent-light: #ff7a50;
        --gr-confirmed: #1f4e79;
        --gr-confirmed-light: #e8f2fa;
        --gr-completed: #0f1620;
        --gr-muted: #7c8796;
        --gr-border: #e3e7ed;
        --gr-bg: #f4f6fb;
        --gr-white: #ffffff;
        --gr-green: #2e8b72;
        --gr-green-light: #e6f5f0;
    }

    /* PAGE */

    .gr-page {
        position: relative;
        font-family: 'Inter', sans-serif;
        min-height: 100vh;
        padding: 48px 40px;
        overflow: hidden;
    }

    /* HEADER */

    .gr-heading {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 800;
        font-size: 3rem;
        letter-spacing: 0.5px;
        color: var(--gr-dark);
        margin-bottom: 4px;
        text-transform: uppercase;
        line-height: 1;
    }

        .gr-heading::after {
            content: "";
            display: block;
            width: 48px;
            height: 4px;
            margin-top: 12px;
            border-radius: 10px;
            background: linear-gradient( 90deg, var(--gr-accent), var(--gr-accent-light) );
        }

    .gr-subtext {
        color: var(--gr-muted);
        font-size: 0.95rem;
        max-width: 520px;
        line-height: 1.65;
        margin-top: 14px;
    }

    /* FILTER */

    .gr-status-filter {
        background: rgba(255,255,255,0.9);
        border: 1px solid var(--gr-border);
        color: var(--gr-dark);
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        font-size: 0.9rem;
        padding: 10px 18px;
        border-radius: 8px;
        box-shadow: 0 4px 14px rgba(15, 22, 32, 0.05);
        transition: all 0.2s ease;
    }

        .gr-status-filter:hover,
        .gr-status-filter:focus {
            background: #fff;
            color: var(--gr-dark);
            border-color: var(--gr-accent);
            box-shadow: 0 6px 18px rgba(255, 87, 34, 0.12);
        }

    .dropdown-menu {
        border: 1px solid var(--gr-border);
        border-radius: 10px;
        padding: 6px;
        box-shadow: 0 15px 35px rgba(15, 22, 32, 0.12);
    }

    .dropdown-item {
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 9px 12px;
    }

        .dropdown-item:hover {
            background: #fff1ec;
            color: var(--gr-accent);
        }

    /* TABLE CARD */

    .gr-table-card {
        position: relative;
        background: rgba(255,255,255,0.96);
        border: 1px solid rgba(227,231,237,0.9);
        border-radius: 14px;
        overflow: hidden;
        margin-top: 32px;
        box-shadow: 0 12px 30px rgba(15, 22, 32, 0.06), 0 2px 5px rgba(15, 22, 32, 0.03);
    }

        /* Orange accent line */

        .gr-table-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient( 90deg, var(--gr-accent), var(--gr-accent-light), #ff9b78 );
            z-index: 2;
        }

    .gr-table {
        margin-bottom: 0;
    }

        /* TABLE HEADER */

        .gr-table thead tr {
            background: linear-gradient( 135deg, var(--gr-dark), var(--gr-dark-soft) );
        }

        .gr-table thead th {
            color: rgba(255,255,255,0.82);
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            font-size: 0.78rem;
            border: none;
            padding: 18px 20px;
            vertical-align: middle;
        }

            .gr-table thead th:first-child {
                padding-left: 24px;
            }

        /* TABLE BODY */

        .gr-table tbody tr {
            position: relative;
            transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
        }

            .gr-table tbody tr:hover {
                background: linear-gradient( 90deg, #fff8f5, #ffffff );
            }

        .gr-table tbody td {
            padding: 20px;
            vertical-align: middle;
            border-top: 1px solid var(--gr-border);
            color: var(--gr-dark);
        }

            .gr-table tbody td:first-child {
                padding-left: 24px;
            }

    /* CLASS */

    .gr-class-name {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 800;
        font-size: 1.15rem;
        letter-spacing: 0.3px;
        text-transform: uppercase;
        margin-bottom: 5px;
        color: var(--gr-dark);
    }

    .gr-class-tag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 0.68rem;
        letter-spacing: 0.7px;
        color: var(--gr-muted);
        text-transform: uppercase;
        font-weight: 700;
    }

        .gr-class-tag::before {
            content: "";
            width: 6px;
            height: 6px;
            background: var(--gr-accent);
            border-radius: 50%;
            box-shadow: 0 0 0 3px rgba(255,87,34,0.1);
        }

    /* TRAINER */

    .gr-trainer {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
    }

    .gr-trainer-avatar {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: linear-gradient( 135deg, #eaf1f7, #d9e7f2 );
        color: var(--gr-confirmed);
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 800;
        font-size: 0.85rem;
        text-transform: uppercase;
    }

    /* DATE */

    .gr-datetime {
        min-width: 145px;
    }

    .gr-datetime-primary {
        font-weight: 700;
        font-size: 0.9rem;
    }

    .gr-datetime-secondary {
        display: inline-block;
        margin-top: 4px;
        color: var(--gr-muted);
        font-size: 0.78rem;
        font-weight: 500;
        background: #f5f7fa;
        padding: 3px 7px;
        border-radius: 4px;
    }

    /* STATUS */

    .gr-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 700;
        font-size: 0.75rem;
        letter-spacing: 0.7px;
        text-transform: uppercase;
        padding: 7px 12px;
        border-radius: 20px;
        white-space: nowrap;
    }

        .gr-badge::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
        }

    .gr-badge-confirmed {
        background: var(--gr-confirmed-light);
        color: var(--gr-confirmed);
        border: 1px solid #d4e5f2;
    }

        .gr-badge-confirmed::before {
            background: var(--gr-confirmed);
            box-shadow: 0 0 0 3px rgba(31,78,121,0.1);
        }

    .gr-badge-completed {
        background: #eef1f4;
        color: var(--gr-completed);
        border: 1px solid #dce1e6;
    }

        .gr-badge-completed::before {
            background: var(--gr-completed);
        }

    .gr-badge-cancelled {
        background: #f7f8fa;
        color: var(--gr-muted);
        border: 1px solid var(--gr-border);
    }

        .gr-badge-cancelled::before {
            background: var(--gr-muted);
        }

    /* ACTION */

    .gr-action-btn {
        font-family: 'Inter', sans-serif;
        font-size: 0.78rem;
        font-weight: 700;
        padding: 7px 15px;
        border-radius: 6px;
        border-width: 1px;
        transition: all 0.2s ease;
    }

        .gr-action-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(220, 53, 69, 0.12);
        }

    /* EMPTY STATE */

    .gr-empty-state {
        text-align: center;
        padding: 80px 20px;
        color: var(--gr-muted);
        font-family: 'Inter', sans-serif;
    }

    .gr-empty-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #fff1ec;
        color: var(--gr-accent);
        font-size: 1.5rem;
        font-weight: 700;
    }

    .gr-empty-title {
        font-family: 'Barlow Condensed', sans-serif;
        text-transform: uppercase;
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--gr-dark);
        margin-bottom: 5px;
    }

    
</style>

<div class="gr-page">

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

        <div>
            <h1 class="gr-heading">My Bookings.</h1>

            <p class="gr-subtext">
                Manage your schedule, track your performance, and prepare for your upcoming sessions.
                Consistency is key.
            </p>
        </div>

        <div class="dropdown">
            <button class="btn gr-status-filter dropdown-toggle"
                    type="button"
                    id="statusFilterBtn"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
                All Status
            </button>

            <ul class="dropdown-menu dropdown-menu-end"
                aria-labelledby="statusFilterBtn">

                <li>
                    <a class="dropdown-item" href="#" data-filter="all">
                        All Status
                    </a>
                </li>

                <li>
                    <a class="dropdown-item" href="#" data-filter="confirmed">
                        Confirmed
                    </a>
                </li>

                <li>
                    <a class="dropdown-item" href="#" data-filter="completed">
                        Completed
                    </a>
                </li>

                <li>
                    <a class="dropdown-item" href="#" data-filter="cancelled">
                        Cancelled
                    </a>
                </li>

            </ul>
        </div>

    </div>

    <div class="gr-table-card">

        @if (Model != null && Model.Any())
        {
            <table class="table gr-table">

                <thead>
                    <tr>
                        <th>Class Name</th>
                        <th>Trainer</th>
                        <th>Date &amp; Time</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var booking in Model)
                    {
                        var status = booking.Class.Time < DateTime.Now
                            ? "completed"
                            : "confirmed";

                        <tr data-status="@status">

                            <td>
                                <div class="gr-class-name">
                                    @booking.Class.Name
                                </div>

                                <div class="gr-class-tag">
                                    Gym Class
                                </div>
                            </td>

                            <td>
                                <div class="gr-trainer">
                                    <div class="gr-trainer-avatar">
                                        @(string.IsNullOrEmpty(booking.Class.Trainer)
                                            ? "?"
                                            : booking.Class.Trainer.Substring(0, 1))
                                    </div>

                                    <span>
                                        @booking.Class.Trainer
                                    </span>
                                </div>
                            </td>

                            <td>
                                <div class="gr-datetime">
                                    <div class="gr-datetime-primary">
                                        @booking.Class.Time.ToString("MMM dd, yyyy")
                                    </div>

                                    <div class="gr-datetime-secondary">
                                        @booking.Class.Time.ToString("hh:mm tt")
                                    </div>
                                </div>
                            </td>

                            <td>

                                @if (status == "confirmed")
                                {
                                    <span class="gr-badge gr-badge-confirmed">
                                        Confirmed
                                    </span>
                                }
                                else
                                {
                                    <span class="gr-badge gr-badge-completed">
                                        Completed
                                    </span>
                                }

                            </td>

                            <td>

                                @if (status == "confirmed")
                                {
                                    <form asp-action="Cancel"
                                          asp-route-id="@booking.Id"
                                          method="post"
                                          onsubmit="return confirm('Cancel this booking?');">

                                        <button type="submit"
                                                class="btn btn-outline-danger gr-action-btn">
                                            Cancel
                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }
        else
        {
            <div class="gr-empty-state">

                <div class="gr-empty-icon">
                    +
                </div>

                <div class="gr-empty-title">
                    No bookings yet
                </div>

                <div>
                    You haven't booked any classes yet.
                </div>

            </div>
        }

    </div>

</div>

<script>
    document.querySelectorAll('[data-filter]').forEach(function(item) {

        item.addEventListener('click', function(e) {

            e.preventDefault();

            var filter = this.getAttribute('data-filter');

            document.getElementById('statusFilterBtn').textContent =
                this.textContent.trim();

            document.querySelectorAll('tbody tr[data-status]').forEach(function(row) {

                if (filter === 'all' ||
                    row.getAttribute('data-status') === filter) {

                    row.style.display = '';
                }
                else {
                    row.style.display = 'none';
                }

            });

        });

    });
</script>
