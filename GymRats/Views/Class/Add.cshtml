@model GymRats.Models.Class

@{
    Layout = "_Layout";
    ViewData["Title"] = "Add Class";
}

<div class="container my-4" style="max-width: 960px;">
    <div class="card p-4 mx-auto" style="max-width: 600px;">
        <h3 class="fw-bold mb-3">Add New Class</h3>

        <form asp-action="Add" method="post">
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-bold">Class Name</label>
                <input asp-for="Name" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="Trainer" class="form-label fw-bold">Trainer</label>
                <input asp-for="Trainer" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="Time" class="form-label fw-bold">Date & Time</label>
                <input asp-for="Time" type="datetime-local" class="form-control" required />
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-danger">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Class</button>
            </div>
        </form>
    </div>
</div>