<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GymRats</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <style>
            :root {
                --color-primary: #b91c1c; /* Crimson Red */
                --color-bg-dark: #0f172a; /* Dark Navy */
                --color-text-muted: #94a3b8;
            }

            /* Ensure footer stays at the bottom */
            body {
                font-family: 'Poppins', sans-serif;
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                margin: 0;
            }

            main {
                flex: 1;
            }

            /* Navbar Styling */
            .custom-navbar {
                background-color: var(--color-bg-dark);
                padding: 16px 0;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            }

            .brand-text {
                font-family: 'Playfair Display', serif;
                font-size: 1.75rem;
                font-weight: 900;
                color: var(--color-primary) !important;
                letter-spacing: 1px;
                text-transform: uppercase;
            }

            .nav-link-custom {
                color: #ffffff !important;
                font-size: 0.85rem;
                font-weight: 600;
                letter-spacing: 1.5px;
                text-transform: uppercase;
                margin-left: 24px;
                transition: color 0.2s ease;
            }

                .nav-link-custom:hover {
                    color: var(--color-primary) !important;
                }

            .navbar-toggler {
                border-color: rgba(255,255,255,0.1);
            }

            /* Footer Styling */
            .custom-footer {
                background-color: var(--color-bg-dark);
                border-top: 4px solid var(--color-primary);
                padding: 48px 0 24px 0;
                margin-top: auto;
            }

            .footer-top {
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap;
                gap: 24px;
            }

            .footer-brand {
                font-family: 'Playfair Display', serif;
                font-size: 2rem;
                font-weight: 900;
                color: var(--color-primary);
                letter-spacing: 1px;
                text-transform: uppercase;
            }

            .footer-links a {
                color: #ffffff;
                text-decoration: none;
                font-size: 0.8rem;
                font-weight: 600;
                letter-spacing: 1.5px;
                margin-left: 32px;
                text-transform: uppercase;
                transition: color 0.2s ease;
            }

                .footer-links a:hover {
                    color: var(--color-primary);
                }

            .footer-divider {
                border-color: rgba(255, 255, 255, 0.1);
                margin: 32px 0 24px 0;
                opacity: 1;
            }

            .footer-bottom {
                text-align: center;
                color: var(--color-text-muted);
                font-size: 0.8rem;
                font-weight: 500;
                letter-spacing: 1px;
                text-transform: uppercase;
            }

            /* Mobile Adjustments for Footer Links */
            @@media (max-width: 768px) {
                .footer-links a {
                    margin-left: 0;
                    margin-right: 24px;
                    display: inline-block;
                    margin-bottom: 12px;
                }
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark custom-navbar">
            <div class="container-fluid container">
                <a class="navbar-brand brand-text" asp-controller="Class" asp-action="Index">GymRats</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    @{
                        var userId = Context.Session.GetInt32("UserId");
                    }
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Class" asp-action="Index">Classes</a>
                        </li>

                        @if (userId != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Booking" asp-action="Index">My Bookings</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Account" asp-action="Profile">Profile</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Account" asp-action="Register">Sign Up</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-5 pt-4">
        @RenderBody()
    </main>

    <footer class="custom-footer">
            <hr class="footer-divider" />

            <div class="footer-bottom">
                &copy; 2026 GYMRAT. FOR THE DRIVEN.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>