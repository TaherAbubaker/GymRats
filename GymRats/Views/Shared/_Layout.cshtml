<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GymRats</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark" style="background-color: var(--color-primary);">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Class" asp-action="Index">GymRats</a>
                <div class="navbar-nav ms-auto">
                    <a class="nav-link text-white" asp-controller="Class" asp-action="Index">Classes</a>

                    @{
                        var userId = Context.Session.GetInt32("UserId");
                    }

                    @if (userId != null)
                    {
                        <a class="nav-link text-white" asp-controller="Booking" asp-action="Index">My Bookings</a>
                        <a class="nav-link text-white" asp-controller="Account" asp-action="Profile">Profile</a>
                        <a class="nav-link text-white" asp-controller="Account" asp-action="Logout">Logout</a>
                    }
                    else
                    {
                        <a class="nav-link text-white" asp-controller="Account" asp-action="Login">Login</a>
                        <a class="nav-link text-white" asp-controller="Account" asp-action="Register">Sign Up</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="text-center text-muted mt-5 mb-3">
        &copy; @DateTime.Now.Year - GymRats
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
